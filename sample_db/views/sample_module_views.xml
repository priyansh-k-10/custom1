<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
         List View
    ========================== -->
    <record id="view_sample_model_list" model="ir.ui.view">
        <field name="name">sample.model.list</field>
        <field name="model">sample.model</field>
        <field name="arch" type="xml">
            <list string="Sample Records">
                <field name="name"/>
                <field name="location"/>
                <field name="email"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- =========================
         Form View
    ========================== -->
    <record id="view_sample_model_form" model="ir.ui.view">
        <field name="name">sample.model.form</field>
        <field name="model">sample.model</field>
        <field name="arch" type="xml">
            <form string="Sample Record">

                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="location"/>
                        </group>

                        <group>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- =========================
         Action Window
    ========================== -->
    <record id="action_sample_model" model="ir.actions.act_window">
        <field name="name">Sample Records</field>
        <field name="res_model">sample.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================
         Main Menu
    ========================== -->
    <menuitem
        id="sample_main_menu"
        name="Sample Module"
        sequence="10"/>

    <!-- =========================
         Sub Menu
    ========================== -->
    <menuitem
        id="sample_sub_menu"
        name="Records"
        parent="sample_main_menu"
        action="action_sample_model"
        sequence="1"/>

</odoo>